# ==============================================================================
# Configuration Environment Template (config.example.env)
# Copy this file to .env and configure with your local or cloud settings
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-to-a-secure-random-secret-key-for-production
PORT=5000

# Google Sheets Integration Configuration
# 1. Place your downloaded Google Cloud service account JSON in this directory as service_account.json
# 2. Provide your target Google Spreadsheet ID below (found in sheet URL: /d/<ID>/edit)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=service_account.json
